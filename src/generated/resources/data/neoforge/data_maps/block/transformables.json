  "values": {
    "thinlogs:thin_acacia_log": {
      "transform_data": {
        "block_state_provider": {
          "type": "minecraft:rule_based",
          "rules": [
            {
              "if_true": {
                "type": "minecraft:matching_blocks",
                "blocks": "thinlogs:thin_acacia_log"
              },
              "then": {
                "type": "minecraft:copy_properties",
                "source": {
                  "id": "thinlogs:thin_stripped_acacia_log",
                  "properties": {
                    "anchor_face": "none",
                    "core_orientation": "vertical",
                    "down": "false",
                    "east": "false",
                    "north": "false",
                    "south": "false",
                    "up": "false",
                    "west": "false"
                  }
                }
              }
            }
          ]
        },
        "item_damage_per_use": 1,
        "sound": "minecraft:item.axe.strip"
      },
      "transformer": "minecraft:axe"
    },
