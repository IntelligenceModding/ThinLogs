{
  "multipart": [
    {
      "apply": {
        "model": "thinlogs:block/thin_bamboo_block_core_vertical"
      },
      "when": {
        "core_orientation": "vertical"
      }
    },
    {
      "apply": {
        "model": "thinlogs:block/thin_bamboo_block_core_east_west"
      },
      "when": {
        "core_orientation": "east_west"
      }
    },
    {
      "apply": {
        "model": "thinlogs:block/thin_bamboo_block_core_north_south"
      },
      "when": {
        "core_orientation": "north_south"
      }
    },
    {
      "apply": {
        "model": "thinlogs:block/thin_bamboo_block_core_junction"
      },
      "when": {
        "core_orientation": "junction"
      }
    },
    {
      "apply": {
        "model": "thinlogs:block/thin_bamboo_block_arm_north"
      },
      "when": {
        "north": "true"
      }
    },
    {
      "apply": {
        "model": "thinlogs:block/thin_bamboo_block_arm_south"
      },
      "when": {
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "thinlogs:block/thin_bamboo_block_arm_east"
      },
      "when": {
        "east": "true"
      }
    },
    {
      "apply": {
        "model": "thinlogs:block/thin_bamboo_block_arm_west"
      },
      "when": {
        "west": "true"
      }
    },
    {
      "apply": {
        "model": "thinlogs:block/thin_bamboo_block_arm_up"
      },
      "when": {
        "up": "true"
      }
    },
    {
      "apply": {
        "model": "thinlogs:block/thin_bamboo_block_arm_down"
      },
      "when": {
        "down": "true"
      }
    }
  ]
}